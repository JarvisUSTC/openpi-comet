# Legacy repo path
SRA_ROOT=/home/simpleai/Jiawei/SimpleRoboAgent

# Shared paths
LOGS_ROOT=/home/simpleai/Jiawei/SimpleRoboAgent/logs
SNAPSHOTS_ROOT=/home/simpleai/Jiawei/SimpleRoboAgent/logs/skill_snapshots
META_ROOT=/home/simpleai/Data/B1K/meta
AUGMENTED_ANNOTATIONS_ROOT=/home/simpleai/Jiawei/annotations_aug_v3
SERVER_STATE_PATH=/home/simpleai/.cache/simpleai/openpi_b1k_server_state.json

# Judge
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=seed-2.0-lite
JUDGE_API_KEY_ENV=OPENROUTER_API_KEY
JUDGE_TIMEOUT_SECONDS=120

# Eval
EVAL_MAX_STEPS=300
EVAL_CONFIGS_ROOT=/home/simpleai/ruike/BEHAVIOR-1K/OmniGibson/omnigibson/learning/configs
EVAL_LOG_PATH=/home/simpleai/Jiawei/SimpleRoboAgent/logs/vla_stopaug_eval
EVAL_VLA_TYPE=openpi-comet
EVAL_ENV_WRAPPER=omnigibson.learning.wrappers.RGBWrapper
EVAL_AUTO_JUDGE=false

# Snapshot
SNAPSHOT_ANNOTATION_ROOT=/home/simpleai/Data/vla_datagen/b1k/annotations
SNAPSHOT_RAW_ROOT=/home/simpleai/Data/b1k_rawdata
SNAPSHOT_CONFIGS_ROOT=/home/simpleai/ruike/BEHAVIOR-1K/OmniGibson/omnigibson/learning/configs
SNAPSHOT_MAX_SKILLS_PER_EPISODE=-1
SNAPSHOT_SEED=7
SNAPSHOT_PLAYBACK_MODE=replay

# Runtime
CONDA_BIN=/home/simpleai/anaconda3/bin/conda
CONDA_ENV=behavior-comet
PYTHON_BIN=python
XLA_PYTHON_CLIENT_PREALLOCATE=false
XLA_PYTHON_CLIENT_MEM_FRACTION=0.5

# Serve
SERVE_PORT=8000
SERVE_BACKEND=
SERVE_POLICY_CONFIG=
SERVE_CHECKPOINT_DIR=

# Serve advanced overrides (optional)
OPENPI_ROOT=
TASK_NAME=
RUIKE_CHECKPOINT_ROOT=
FINE_GRAINED_LEVEL=0
